            }
        },
        "Backdrop_1": {
            "nodeType": "Backdrop",
            "position": [
                123,
                -159
            ],
            "internalInputs": {
                "comment": "To access the project folder: \n- Right-click on the 'MicMacProject' node\n- Select 'Open Folder'\n- Open the 'project' folder. \n\nAll calculations are stored in this folder.",
                "label": "MicMac Project",
                "fontSize": 10,
                "nodeWidth": 253,
                "nodeHeight": 330
            }
        },
        "Backdrop_2": {
            "nodeType": "Backdrop",
            "position": [
                2350,
                -198
            ],
            "internalInputs": {
                "comment": "Georeferencing with the embedded GPS, computed in the local tangent frame (RTL):\n1) 'CenterBascule' moves the relative block onto the GPS camera centers\n2) 'Campari' refines the block with the GPS centers ('Em GPS') and the tie points\n3) 'ChgSysCo' converts the orientation to the map projection ('Import SysCo Projection')",
                "label": "Georeferencing (RTL -> Map Projection)",
                "fontSize": 10,
                "nodeWidth": 820,
                "nodeHeight": 473
            }
        },
        "Backdrop_3": {
            "nodeType": "Backdrop",
            "position": [
                3230,
                -198
            ],
            "internalInputs": {
                "comment": "Orthophoto in the map projection:\n1) Draw the area to process on the TA image ('SaisieMasqQT TA'), used by Malt through 'DirTA'\n2) 'Tawny' builds the mosaic, possibly split into tiles\n3) 'ConvertImages' converts the mosaic (or each tile) into a standard TIFF",
                "label": "Orthophoto",
                "fontSize": 10,
                "nodeWidth": 1027,
                "nodeHeight": 330
            }
        },
        "Backdrop_4": {
            "nodeType": "Backdrop",
            "position": [
                404,
                -159
            ],
            "internalInputs": {
                "comment": "Project files, chosen in the 'Import' nodes and copied into the project folder:\n1) 'Import GPS': the GPS file\n2) 'Import SysCo RTL': the local tangent system (origin near the site); its 'Change System' converts the GPS (DegreeWGS84) into it\n3) 'Import SysCo Projection': the map projection; its 'Change System' converts the RTL system into it",
                "label": "Project Files",
                "fontSize": 10,
                "nodeWidth": 680,
                "nodeHeight": 326
            }
        },
        "Backdrop_5": {
            "nodeType": "Backdrop",
            "position": [
                122,
                -451
            ],
            "internalInputs": {
                "comment": "UAS Grand-Leez (200 images): http://web.archive.org/web/20260303004211/https://micmac.ensg.eu/data/uas_grand_leez_dataset.zip\n- 'Import GPS': GPS_WPK_Grand-Leez.csv\n- 'Import SysCo RTL': SysCoRTL.xml (origin = first camera R0040438.JPG)\n- 'Import SysCo Projection': SysCoBL72_EPSG31370.xml (Belgian Lambert 72, EPSG:31370)\n- 'OriConvert GPS': 'Image Center' = R0040536.JPG\n- 'Tapas Calib': 'Image Pattern' = the PATC of the 'OriConvert GPS' log (25 images around R0040536.JPG)\n- 'Campari': 'Sigma' = 5 (no RTK)",
                "label": "Example Dataset (UAS Grand-Leez)",
                "fontSize": 10,
                "nodeWidth": 957,
                "nodeHeight": 260
            }
        },
        "CameraInit_1": {
            "nodeType": "CameraInit",
            "position": [
                -66,
                2
            ],
            "inputs": {}
        },
        "Campari_1": {
            "nodeType": "Campari",
            "position": [
                2570,
                -37
            ],
            "inputs": {
                "projectDirectory": "{CenterBascule_1.projectDirectory}",
                "imagePattern": "{CenterBascule_1.imagePattern}",
                "inputOrientation": "{CenterBascule_1.orientationOut}",
                "SH": "{Tapas_2.SH}",
                "setEmGPS": true,
                "EmGPS": {
                    "orientation": "{OriConvert_1.orientationOut}",
                    "sigma": 5.0
                },
                "AllFree": true
            },
            "internalInputs": {
                "comment": "Set 'Sigma' of 'Em GPS' to the GPS accuracy (a few meters without RTK)."
            }
        },
        "CenterBascule_1": {
            "nodeType": "CenterBascule",
            "position": [
                2370,
                -37
            ],
            "inputs": {
                "projectDirectory": "{Tapas_2.projectDirectory}",
                "imagePattern": "{Tapas_2.imagePattern}",
                "orientationIn": "{Tapas_2.orientationDirectory}",
                "LocalizationOfICenters": "{OriConvert_1.orientationOut}",
                "Out": "All-RTL"
            }
        },
        "ChgSysCo_1": {
            "nodeType": "ChgSysCo",
            "position": [
                2770,
                -37
            ],
            "inputs": {
                "projectDirectory": "{Campari_1.projectDirectory}",
                "imagePattern": "{Campari_1.imagePattern}",
                "orientationIn": "{Campari_1.Out}",
                "ChgSyst": "{MicMacImportSysCo_2.changeSystem}",
                "Out": "All-Proj"
            }
        },
        "ConvertImages_1": {
            "nodeType": "ConvertImages",
            "position": [
                4069,
                -37
            ],
            "inputs": {
                "projectDirectory": "{Tawny_1.projectDirectory}",
                "imagePattern": "{Tawny_1.outImagePattern}"
            },
            "internalInputs": {
                "comment": "Converts the mosaic, or each of its tiles, into a standard TIFF (tiles are not merged)."
            }
        },
        "MaltOrtho_1": {
            "nodeType": "MaltOrtho",
            "position": [
