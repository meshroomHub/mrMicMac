                "sourceFile": "{MicMacImportSysCo_1.filename}"
            },
            "internalInputs": {
                "label": "Import SysCo Projection"
            }
        },
        "MicMacProject_1": {
            "nodeType": "MicMacProject",
            "position": [
                177,
                2
            ],
            "inputs": {
                "input": "{CameraInit_1.output}"
            },
            "internalInputs": {
                "color": "#602d2d"
            }
        },
        "OriConvert_1": {
            "nodeType": "OriConvert",
            "position": [
                1285,
                -32
            ],
            "inputs": {
                "projectDirectory": "{MicMacImportFile_1.projectDirectory}",
                "orientationFile": "{MicMacImportFile_1.filename}",
                "targetedOrientation": "Nav-Brut-RTL",
                "ChSys": "{MicMacImportSysCo_1.changeSystem}",
                "NameCple": "FileImagesNeighbour.xml",
                "setCalcV": true,
                "CalcV": true,
                "setNbImC": true,
                "NbImC": 25
            },
            "internalInputs": {
                "comment": "Converts the GPS file, computes the image pairs and the speed, and selects the calibration sub-block around 'Image Center' (printed as PATC in the log). Set 'Image Center' (required).",
                "label": "OriConvert GPS"
            }
        },
        "SaisieMasqQT_1": {
            "nodeType": "SaisieMasqQT",
            "position": [
                3469,
                -37
            ],
            "inputs": {
                "projectDirectory": "{Tarama_1.projectDirectory}",
                "filePath": "{Tarama_1.taImage}"
            },
            "internalInputs": {
                "comment": "Draw the ortho area on the TA image (mask used by Malt through 'DirTA').",
                "label": "SaisieMasqQT TA"
            }
        },
        "Tapas_1": {
            "nodeType": "Tapas",
            "position": [
                1685,
                -32
            ],
            "inputs": {
                "projectDirectory": "{TapiocaFile_1.projectDirectory}",
                "imagePattern": "[a-zA-Z0-9_.-]*[.](jpg|jpeg|JPG|JPEG|png|PNG)",
                "SH": "{TapiocaFile_1.PostFix}",
                "Out": "Sample4Calib-Rel"
            },
            "internalInputs": {
                "comment": "To calibrate on a sub-block, set 'Image Pattern' to the PATC printed in the 'OriConvert GPS' log.",
                "label": "Tapas Calib"
            }
        },
        "Tapas_2": {
            "nodeType": "Tapas",
            "position": [
                1885,
                -32
            ],
            "inputs": {
                "projectDirectory": "{Tapas_1.projectDirectory}",
                "imagePattern": "[a-zA-Z0-9_.-]*[.](jpg|jpeg|JPG|JPEG|png|PNG)",
                "calibrationModel": "{Tapas_1.calibrationModel}",
                "InCal": "{Tapas_1.orientationDirectory}",
                "SH": "{Tapas_1.SH}",
                "Out": "All-Rel"
