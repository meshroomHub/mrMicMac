        },
        "AperiCloud_3": {
            "nodeType": "AperiCloud",
            "position": [
                2968,
                133
            ],
            "inputs": {
                "projectDirectory": "{ChgSysCo_1.projectDirectory}",
                "imagePattern": "{ChgSysCo_1.imagePattern}",
                "SH": "{Tapas_2.SH}",
                "orientationDir": "{ChgSysCo_1.orientationOut}",
                "WithPoints": false,
                "Out": "All-Proj-cam.pc.ply"
