                "nodeHeight": 330
            }
        },
        "Backdrop_2": {
            "nodeType": "Backdrop",
            "position": [
                872,
                8
            ],
            "internalInputs": {
                "comment": "Relative orientation and scene measurements (shared by A1 and A2):\n1) 'Tapas' self-calibrates the camera ('RadialBasic')\n2) 'SaisieMasqQT Facade' draws the facade plane on one image\n3) 'SaisieBascQT' measures 'Line1', 'Line2' (X axis), 'Origine' and 'Ech1', 'Ech2' (scale)",
                "label": "Common",
                "fontSize": 10,
                "nodeWidth": 820,
                "nodeHeight": 330
            }
        },
        "Backdrop_3": {
            "nodeType": "Backdrop",
            "position": [
                2335,
                -283
            ],
            "internalInputs": {
                "comment": "Absolute orientation from the captured GCPs ('GCPBascule'), then local facade frame with 'RepLocBascule' (does not change the orientation).",
                "label": "A1 - Frame From GCPs",
                "fontSize": 10,
                "nodeWidth": 1499,
                "nodeHeight": 310
            }
        },
        "Backdrop_4": {
            "nodeType": "Backdrop",
            "position": [
                2330,
                59
            ],
            "internalInputs": {
                "comment": "Frame from the scene with 'SBGlobBascule': plane = facade mask, X axis = Line1/Line2, scale = DistFS between Ech1 and Ech2.",
                "label": "A2 - Frame From Scene",
                "fontSize": 10,
                "nodeWidth": 1502,
                "nodeHeight": 332
            }
        },
        "Backdrop_5": {
            "nodeType": "Backdrop",
            "position": [
                878,
                -326
            ],
            "internalInputs": {
                "comment": "Project files:\n- 'Import GCP': the GCP coordinates file also used as the point names of 'SaisieAppuisInitQT'\n- 'Import Ref Measures' (only for 'GCPBascule Ref'): reference image measures\n- 'Import Calibration' (optional): a reference calibration; link its 'Orientation Directory' to the 'Calibration Directory' of 'Tapas' and set 'Figee'",
                "label": "Project Files",
                "fontSize": 10,
                "nodeWidth": 812,
                "nodeHeight": 300
            }
        },
        "Backdrop_6": {
            "nodeType": "Backdrop",
            "position": [
                2063,
                -540
            ],
            "internalInputs": {
                "comment": "Compare the GCPBascule residuals with reference image measures. Compute it manually: it fails when 'Import Ref Measures' is empty.",
                "label": "Optional: Check With Reference Measures",
                "fontSize": 10,
                "nodeWidth": 640,
                "nodeHeight": 200
            }
        },
        "Backdrop_7": {
            "nodeType": "Backdrop",
            "position": [
                -361,
                -459
            ],
            "internalInputs": {
                "comment": "Mur Saint Martin (MMVII-TestDir/Input/Saisies-MMV1): 4 images IMGP4167-4170, 1728x1152 (hence full resolution in 'TapiocaAll')\n- 'SaisieMasqQT Facade': 'Filename' = IMGP4168.JPG\n- 'Import GCP': Ground-Pts3D.xml; only 6 GCPs usable: Acute, Finger-1, Grille, I-of-I, Stone-6, Stone-7\n- 'Import Ref Measures': GroundMeasure.xml\n- 'Import Calibration' (optional): Ori-Ground_mm3d; link it to the 'Calibration Directory' of 'Tapas' and set 'Figee'\n- 'SBGlobBascule': Ech1 = Stone-7, Ech2 = Grille, 'DistFS' = 2.17\nExpected GCPBascule residuals: 3-21 mm (self-calibration), 3-12 mm with 'Figee'.",
                "label": "Example Dataset (Mur Saint Martin)",
                "fontSize": 10,
                "nodeWidth": 1080,
                "nodeHeight": 260
            }
        },
